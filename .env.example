# SignalDoor Environment Variables Example
# Copy to .env and customize. NEVER commit .env to version control!

# Application Server
PORT=3000
NODE_ENV=development

# Ring Adapter Mode ('emulator' or 'live')
RING_MODE=emulator

# Ring Webhook HMAC Secret (used to verify x-ring-signature header)
RING_WEBHOOK_SECRET=dev-ring-hmac-secret-key-32chars-min

# Ring OAuth Configuration (for live mode)
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REDIRECT_URI=http://localhost:3000/oauth/callback

# Internal Secret (protects simulator triggers & admin actions from external tunnel access)
INTERNAL_DEV_SECRET=dev-local-secret-change-me

# AWS Bedrock Configuration
AWS_REGION=us-east-1
# AWS credentials can be left blank if using AWS CLI / default credentials provider chain
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Current small fast multimodal model available in region with model access enabled
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Database
DATABASE_PATH=./signaldoor.db
